---
import Polaroid from "../polaroids/Polaroid.astro";
import ScrollIndicator from "../common/ScrollIndicator.astro";
---

<section id="index" class="hero" aria-labelledby="hero-title">
  <div class="hero-polaroids" aria-hidden="true">
    <Polaroid className="intro-card intro-card--album" image="/images/album/Omakase.png" alt="Portada del album OMAKASE" label="IMAGE PENDING" caption="01 / OMAKASE" />
    <Polaroid className="intro-card intro-card--artist" image="/images/artist/AlvaroDiaz.jpg" alt="Alvaro Diaz vestido de chef" label="ARTIST PHOTO" caption="02 / ALVARO" />
    <Polaroid className="intro-card intro-card--city" image="/images/polaroids/PortadaOmakase.jpeg" alt="Anuncio de OMAKASE" label="CITY RIDE" caption="03 / OMAKASE 2026" />
    <Polaroid className="intro-card intro-card--plate" image="/images/polaroids/concert.jpg" alt="Cassette y disco de OMAKASE" label="CHEF MENU" caption="04 / TRUST THE CHEF" />
  </div>
  <div class="hero-copy">
    <p class="eyebrow hero-kicker">UN MENU EMOCIONAL / ALVARO DIAZ / 2026</p>
    <div class="hero-title-wrap"><h1 id="hero-title" class="hero-title">OMAKASE</h1></div>
    <p class="hero-intro">Deja que el chef elija el ritmo. Una experiencia conceptual servida entre memoria, ciudad y sonido.</p>
  </div>
  <span class="hero-symbol" aria-hidden="true">&gt;|&lt;</span>
  <ScrollIndicator />
</section>
