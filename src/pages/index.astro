---
import MainLayout from "../layouts/MainLayout.astro";
import HeroIntro from "../components/sections/HeroIntro.astro";
import AboutOmakase from "../components/sections/AboutOmakase.astro";
import SpotifySection from "../components/sections/SpotifySection.astro";
import SoundsSection from "../components/sections/SoundsSection.astro";
import Footer from "../components/common/Footer.astro";
import { tracks } from "../data/tracks";
---

<MainLayout title="OMAKASE - Álvaro Díaz | Experiencia Conceptual">
  <div class="intro-story">
    <HeroIntro />
    <AboutOmakase />
  </div>
  <SpotifySection />
  <SoundsSection tracks={tracks} />
  <Footer />
</MainLayout>
