---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/common/Navbar.astro";
import PageTransition from "../components/common/PageTransition.astro";
import "../styles/global.css";

type Props = { title: string; description?: string };
const { title, description = "Una experiencia conceptual inspirada en OMAKASE de Álvaro Díaz." } = Astro.props;
---

<!doctype html>
<html lang="es" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e7e5e0" />
    <link rel="icon" type="image/png" href="/images/tools/omakase_logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Modak&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <Navbar />
    <main><slot /></main>
    <PageTransition />
    <div class="custom-cursor" aria-hidden="true">
      <span class="custom-cursor__label custom-cursor__label--view">View</span>
      <span class="custom-cursor__label custom-cursor__label--drag">Drag</span>
      <span class="custom-cursor__label custom-cursor__label--spin">Spin</span>
    </div>
    <script>
      import "../scripts/siteMotion";
      import "../scripts/pageTransition";
    </script>
  </body>
</html>
